  "samSchema": [
    {
      "Table": "sam_players",
      "Create Table": "CREATE TABLE `sam_players` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `room_id` bigint unsigned NOT NULL,\n  `user_id` bigint unsigned NOT NULL,\n  `seat_index` int unsigned NOT NULL,\n  `hand_cards` json NOT NULL,\n  `remaining_cards_count` int unsigned NOT NULL DEFAULT '10',\n  `status` enum('WAITING','ACTIVE','FINISHED','SURRENDERED','DISCONNECTED') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'WAITING',\n  `has_declared_sam` tinyint(1) NOT NULL DEFAULT '0',\n  `is_bao_mot` tinyint(1) NOT NULL DEFAULT '0',\n  `score_delta` int NOT NULL DEFAULT '0',\n  `rank` int unsigned DEFAULT NULL,\n  `joined_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n  `player_type` enum('HUMAN','BOT') CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'HUMAN',\n  `is_bot` tinyint(1) NOT NULL DEFAULT '0',\n  `bot_id` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `bot_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `is_ready` tinyint(1) NOT NULL DEFAULT '0',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `idx_sam_players_room_user_unique` (`room_id`,`user_id`),\n  UNIQUE KEY `idx_sam_players_room_seat_unique` (`room_id`,`seat_index`),\n  KEY `user_id` (`user_id`),\n  CONSTRAINT `sam_players_ibfk_1` FOREIGN KEY (`room_id`) REFERENCES `sam_rooms` (`id`) ON DELETE CASCADE,\n  CONSTRAINT `sam_players_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE,\n  CONSTRAINT `sam_players_ibfk_3` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`) ON DELETE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
    }
  ]
}