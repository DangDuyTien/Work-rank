NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# Google OAuth 2.0 Web application credentials (keep the client secret on the backend only)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workrank_realtime
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false

JWT_SECRET=replace-with-strong-access-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

TRADINGVIEW_WEBHOOK_SECRET=replace-with-tradingview-secret

# ── Drawing / Góc Sáng Tạo image storage ──────────────────────────────────────
# local = chỉ đọc/migrate ảnh cũ và unit test; không cho publish mới ở development/production.
# s3 = bắt buộc khi publish (AWS S3 / Cloudflare R2 / MinIO / Supabase S3)
STORAGE_PROVIDER=local

# Local adapter (legacy/tooling)
# STORAGE_LOCAL_DIR=/absolute/path/to/uploads
# STORAGE_LOCAL_PUBLIC_PREFIX=/uploads

# S3-compatible adapter (production)
# STORAGE_BUCKET=workrank-media
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_KEY_PREFIX=workrank

SEED_ADMIN_NAME=Duy Tiến (Admin)
SEED_ADMIN_EMAIL=tienddph50842@gmail.com
SEED_ADMIN_PASSWORD=123456

# ── Private Media (owner-only capability) ────────────────────────────────────
# Server-side secrets only. Never expose through API responses or the frontend bundle.
# Bootstrap owner email is resolved ONCE into a canonical Work Rank user id.
PRIVATE_MEDIA_BOOTSTRAP_OWNER_EMAIL=tienddph50842@gmail.com
# Telegram bot for remote control (leave empty to disable the bot entirely).
TELEGRAM_BOT_TOKEN=
# YouTube Data API v3 key for in-app video search (leave empty to disable search;
# loading a video by URL still works through keyless oEmbed metadata).
YOUTUBE_API_KEY=
# Pairing code lifetime in milliseconds (Telegram binding + Mac helper).
PRIVATE_MEDIA_PAIRING_TTL_MS=600000
