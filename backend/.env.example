NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workrank_realtime
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false

JWT_SECRET=replace-with-strong-access-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

TRADINGVIEW_WEBHOOK_SECRET=replace-with-tradingview-secret

SEED_ADMIN_NAME=WorkRank Admin
SEED_ADMIN_EMAIL=admin@workrank.local
SEED_ADMIN_PASSWORD=Admin@123456
